<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekly revalidation of the PASSED book: does each stored verdict still hold on
  current data?

  READ-ONLY: scripts/revalidate_passed.py re-scores the in-sample and walk-forward
  stages and stops before the holdout. It writes no validation row, places no order
  and touches no runner state, so this job is NOT a trading action, no interlock.

  StartInterval, NOT StartCalendarInterval: there is no external event to align to
  and a wall-clock time would only drift at DST. The 7-day period is a ceiling on
  how long a silently stale pass can go unnoticed, not a runtime constraint. One
  run is about 7 minutes and re-running is free.

  Install: cp to ~/Library/LaunchAgents/com.lich.revalidate.plist then
           launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.lich.revalidate.plist

  REPAIRED 2026-10-12: committed XML-invalid, with six stray DOCTYPE lines
  interleaved through split comment fragments. plistlib and xmllint both rejected
  the file; only Apple's lenient plutil parsed it, which is why nothing noticed.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lich.revalidate</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/lich/deepseek-oanda-trading/run_revalidate.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/lich/deepseek-oanda-trading</string>

    <key>StartInterval</key>
    <integer>604800</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/lich/deepseek-oanda-trading/.paper-trading-logs/revalidate_passed.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/lich/deepseek-oanda-trading/.paper-trading-logs/revalidate_passed.log</string>
</dict>
</plist>