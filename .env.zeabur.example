# Zeabur environment variables for Docker/FIX runner.
# Fill values in Zeabur dashboard. Do not commit real secrets.

# Required: OANDA data/pricing source
OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=

# Required: cTrader FIX execution
FIX_PASSWORD=
FIX_USERNAME=5047309
FIX_SENDER_COMP_ID=live.the5ers.5047309
FIX_TARGET_COMP_ID=cServer
FIX_SENDER_SUB_ID=TRADE
FIX_TARGET_SUB_ID=TRADE
FIX_HOST=live-uk-eqx-01.p.c-trader.com
FIX_PORT=5212
FIX_START_EQUITY=2500

# Risk/schedule. BASE_RISK is the pod's magnitude knob (FIX_RISK retired 2026-08-08).
# Live pod value 2026-10-06: 0.0145 (from 0.007 -> 274d median, 733d p95, 93.5% pass,
# 4.5% total-DQ on the 2020-08+ real-sized curve; knee of the days-vs-DQ frontier). Keep this file and
# the Zeabur dashboard in step: a redeploy re-applies the dashboard's value.
BASE_RISK=0.0145
BOOK_SCALE=1.0
FIX_MAXRISK=0.02
FIX_RUN_AT=21:05

# Optional: daily manual broker balance reconcile
FIX_BROKER_BALANCE=2412

# Optional diagnostics; leave empty/0 normally
FIX_DEBUG=
FIX_PROBE=
